{
	"name": "@stump/monorepo",
	"version": "0.1.9",
	"repository": "https://github.com/coppice-media/coppice.git",
	"author": "Aaron Leopold <aaronleopold1221@gmail.com>",
	"license": "MIT",
	"private": true,
	"workspaces": [
		"docs",
		"home",
		"editor",
		"packages/stump-ui"
	],
	"scripts": {
		"setup": "bun install --frozen-lockfile && bun run home build && bun run editor build",
		"lint": "bun run --filter '*' --parallel --if-present lint && bun run check-types",
		"check-types": "bun run --filter '*' --parallel --if-present check-types",
		"docs": "bun run --filter @stump/docs",
		"home": "bun run --filter home",
		"editor": "bun run --filter editor",
		"format": "bun run --filter '*' --parallel --if-present format",
		"release": "bun scripts/release/bump-version.mjs",
		"check:komf-contract": "bun scripts/extract-komf-contract.mjs --check",
		"update:komf-contract": "bun scripts/extract-komf-contract.mjs --write",
		"inspect:komf-latest": "bun scripts/extract-komf-contract.mjs --latest",
		"check:upstreams": "bun scripts/check-upstreams.mjs",
		"clean": "bun run --filter '*' --if-present clean"
	},
	"devDependencies": {
		"@0no-co/graphqlsp": "^1.15.4",
		"@clack/prompts": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-sort-keys-fix": "^1.1.2",
		"execa": "^9.6.1",
		"gitmoji-changelog": "^2.3.0",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1"
	},
	"overrides": {
		"vite": "^8.2.2",
		"postcss": "^8.5.10",
		"date-fns": "4.1.0",
		"@xmldom/xmldom": ">=0.8.13 <0.9.0",
		"uuid": ">=11.1.1",
		"js-cookie": ">=3.0.7"
	},
	"engines": {
		"bun": "1.4.1"
	},
	"packageManager": "bun@1.4.1",
	"dependencies": {}
}
