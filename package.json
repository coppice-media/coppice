{
	"name": "@stump/monorepo",
	"version": "0.1.9",
	"repository": "https://github.com/coppice-media/coppice.git",
	"author": "Aaron Leopold <aaronleopold1221@gmail.com>",
	"license": "SEE README.md",
	"private": true,
	"workspaces": [
		"apps/web",
		"apps/desktop",
		"docs",
		"packages/*",
		"home",
		"editor"
	],
	"scripts": {
		"setup": "bun install --frozen-lockfile && bun run web build",
		"lint": "bun run --filter '*' --parallel --if-present lint && bun run check-types",
		"check-types": "bun run --filter '*' --parallel --if-present check-types",
		"test": "bun run --filter '*' --if-present test",
		"client": "bun run --filter @stump/client",
		"desktop": "bun run --filter @stump/desktop",
		"browser": "bun run --filter @stump/browser",
		"web": "bun run --filter @stump/web",
		"docs": "bun run --filter @stump/docs",
		"home": "bun run --filter home",
		"editor": "bun run --filter editor",
		"start:desktop": "concurrently -n server,desktop -c green.bold,blue.bold \"cargo run -p stump_server\" \"bun run desktop start\"",
		"dev:desktop": "concurrently -n server,desktop -c green.bold,blue.bold \"cargo run -p stump_server\" \"bun run desktop dev\"",
		"dev:web": "concurrently -n server,web -c green.bold,blue.bold \"bacon run-server --headless\" \"bun run web dev\"",
		"format": "bun run --filter '*' --parallel --if-present format",
		"release": "node scripts/release/bump-version.mjs",
		"check:komf-contract": "node scripts/extract-komf-contract.mjs --check",
		"update:komf-contract": "node scripts/extract-komf-contract.mjs --write",
		"inspect:komf-latest": "node scripts/extract-komf-contract.mjs --latest",
		"check:upstreams": "node scripts/check-upstreams.mjs",
		"clean": "bun run --filter '*' --if-present clean",
		"graphql": "bun run --filter @stump/graphql"
	},
	"devDependencies": {
		"@0no-co/graphqlsp": "^1.15.4",
		"@babel/core": "^7.28.5",
		"@babel/traverse": "^7.28.5",
		"@clack/prompts": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@typescript-eslint/eslint-plugin": "^8.48.1",
		"@typescript-eslint/parser": "^8.58.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"citty": "^0.2.2",
		"concurrently": "^8.2.2",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-compiler": "^19.1.0-rc.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-sort-keys-fix": "^1.1.2",
		"execa": "^9.6.1",
		"gitmoji-changelog": "^2.3.0",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1"
	},
	"overrides": {
		"vite": "^8.2.2",
		"postcss": "^8.5.10",
		"@types/react": "~19.2.10",
		"react": "=19.2.3",
		"react-dom": "=19.2.3",
		"@tanstack/query-devtools": "5.91.1",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-query-devtools": "5.91.1",
		"date-fns": "4.1.0",
		"@xmldom/xmldom": ">=0.8.13 <0.9.0",
		"uuid": ">=11.1.1",
		"js-cookie": ">=3.0.7"
	},
	"engines": {
		"bun": "1.4.1",
		"node": ">=20.0.0"
	},
	"packageManager": "bun@1.4.1",
	"dependencies": {}
}
